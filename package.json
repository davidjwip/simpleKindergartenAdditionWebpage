{
  "name": "math-game-vue",
  "private": true,
  "version": "0.1.0",
  "description": "Fun math practice for kindergarten kids (Vue 3 migration)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:coverage:threshold": "vitest run --coverage --coverage.thresholds.lines=80 --coverage.thresholds.functions=80 --coverage.thresholds.branches=80 --coverage.thresholds.statements=80",
    "prepare": "husky"
  },
  "dependencies": {
    "vue": "^3.4.21"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.4",
    "@vitest/coverage-v8": "^1.6.1",
    "@vue/test-utils": "^2.4.5",
    "happy-dom": "^20.11.15",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "vite": "^5.2.0",
    "vitest": "^1.6.0"
  }
}
